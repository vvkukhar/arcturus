{
  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@arcturus/shared": ["packages/shared/src"],
      "@arcturus/db": ["packages/db/src"],
      "@arcturus/scrapers": ["apps/scrapers/src"]
    }
  }
}