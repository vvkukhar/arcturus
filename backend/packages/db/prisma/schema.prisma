generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

model User {
  id                     String          @id @default(cuid())
  name                   String
  email                  String?         @unique
  passwordHash           String?
  role                   String          @default("operator")
  phone                  String?
  payoutCard             String?
  active                 Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
  sessions               UserSession[]
  assignedInventoryItems InventoryItem[]
  assignedWatchlistItems WatchlistItem[]
  notifications          Notification[]
  purchaseOrders         PurchaseOrder[]
  expenses               Expense[]
  auditLogs              AuditLog[]
  sellerItems            InventoryItem[] @relation("SellerItems")
  
  // PRO SAAS & BOUNTY SCOUT FIELDS
  isPro                  Boolean         @default(false)
  proExpiresAt           DateTime?
  payoutRequests         PayoutRequest[]
  scoutLeads             ScoutLead[]

  @@index([role, active])
  @@index([active])
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Item {
  id                String             @id @default(cuid())
  kind              String             @default("set")
  title             String
  setNumber         String?
  theme             String?
  conditionDefault  String?            @default("used")
  imageUrl          String?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  inventoryItems    InventoryItem[]
  watchlistItems    WatchlistItem[]
  marketListings    MarketListing[]
  marketSnapshots   MarketSnapshot[]
  decisionSnapshots DecisionSnapshot[]
  soldComps         SoldComp[]
  sales             Sale[]
  purchaseOrders    PurchaseOrder[]

  @@unique([setNumber, kind])
  @@index([kind, theme])
  @@index([theme])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Warehouse {
  id             String            @id @default(cuid())
  code           String            @unique
  name           String
  address        String?
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt
  locations      StorageLocation[]
  stockMovements StockMovement[]

  @@index([active])
}

model StorageLocation {
  id             String          @id @default(cuid())
  warehouseId    String
  code           String
  name           String
  zone           String?
  shelf          String?
  box            String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([warehouseId, code])
  @@index([warehouseId, active])
}

model InventoryItem {
  id                      String            @id @default(cuid())
  itemId                  String
  titleSnapshot           String
  purchasePrice           Float
  totalCost               Float
  quantity                Int               @default(1)
  condition               String            @default("used")
  sealed                  Boolean           @default(false)
  expectedSalePriceManual Float?
  source                  String?
  purchaseUrl             String?
  storageLocation         String?
  storageLocationId       String?
  warehouseId             String?
  notes                   String?
  priority                Int               @default(50)
  
  // MARKETPLACE FIELDS
  isMarketplace           Boolean           @default(false) 
  sellerId                String?            
  commissionRate          Float             @default(5.0)
  sellerPayout            Float? 
  approvalStatus          String            @default("approved") 

  assignedUserId          String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @default(now()) @updatedAt
  
  item                    Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  assignedUser            User?             @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  seller                  User?             @relation("SellerItems", fields: [sellerId], references: [id], onDelete: SetNull)
  location                StorageLocation?  @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  images                  InventoryImage[]
  sales                   Sale[]
  repriceFlows            RepriceFlowItem[]
  reviewFlows             ReviewFlowItem[]
  stockMovements          StockMovement[]
  reserveRequests         ReserveRequest[]
  orders                  Order[]
  purchaseOrders          PurchaseOrder[]
  returns                 ReturnRequest[]
  expenses                Expense[]

  @@index([itemId, quantity])
  @@index([assignedUserId, quantity])
  @@index([isMarketplace, approvalStatus])
  @@index([warehouseId, storageLocationId])
  @@index([quantity, expectedSalePriceManual])
  @@index([titleSnapshot(ops: raw("gin_trgm_ops"))], type: Gin)
}

model StockMovement {
  id                    String         @id @default(cuid())
  inventoryItemId       String
  warehouseId           String?
  fromStorageLocationId String?
  toStorageLocationId   String?
  type                  String
  quantity              Int            @default(1)
  reason                String?
  createdAt             DateTime       @default(now())
  inventoryItem         InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  warehouse             Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, type])
  @@index([warehouseId, createdAt])
}

model InventoryImage {
  id              String        @id @default(cuid())
  inventoryItemId String
  imageUrl        String
  altText         String?
  isPrimary       Boolean       @default(false)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, isPrimary, sortOrder])
}

model WatchlistItem {
  id              String             @id @default(cuid())
  itemId          String
  titleSnapshot   String
  desiredBuyPrice Float
  maxBuyPrice     Float
  targetSellPrice Float?
  active          Boolean            @default(true)
  priority        Int                @default(50)
  notes           String?
  assignedUserId  String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
  item            Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  assignedUser    User?              @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  purchaseFlows   PurchaseFlowItem[]
  deals           Deal[]
  purchaseOrders  PurchaseOrder[]

  @@index([itemId, active])
  @@index([active, priority])
  @@index([titleSnapshot(ops: raw("gin_trgm_ops"))], type: Gin)
}

model PurchaseOrder {
  id              String         @id @default(cuid())
  itemId          String
  watchlistItemId String?
  inventoryItemId String?
  assignedUserId  String?
  titleSnapshot   String
  sourceCode      String?
  supplierName    String?
  sourceUrl       String?
  status          String         @default("planned")
  plannedPrice    Float?
  actualPrice     Float?
  shippingPrice   Float?
  totalCost       Float?
  targetSellPrice Float?
  quantity        Int            @default(1)
  condition       String         @default("used")
  sealed          Boolean        @default(false)
  notes           String?
  purchasedAt     DateTime?
  receivedAt      DateTime?
  createdAt       DateTime       @allowed
  updatedAt       DateTime       @default(now()) @updatedAt
  item            Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  watchlistItem   WatchlistItem? @relation(fields: [watchlistItemId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  assignedUser    User?          @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  expenses        Expense[]

  @@index([status, createdAt])
  @@index([itemId, status])
}

model MarketSource {
  id        String          @id @default(cuid())
  code      String          @unique
  name      String
  type      String          @default("manual")
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  listings  MarketListing[]
  runs      SourceRunLog[]

  @@index([enabled, type])
}

model MarketListing {
  id                  String                 @id
  sourceId            String
  sourceCode          String
  itemId              String
  externalListingId   String
  externalId          String?
  titleRaw            String
  title               String
  url                 String
  imageUrl            String?
  sellerName          String?
  sellerRating        Float?
  price               Float
  currency            String                 @default("UAH")
  shippingPrice       Float?
  shippingCurrency    String?
  country             String?
  condition           String?
  sealed              Boolean?
  completenessPercent Int?
  quantityAvailable   Int?
  status              String                 @default("active")
  fetchedAt           DateTime               @default(now())
  firstSeenAt         DateTime               @default(now())
  lastSeenAt          DateTime               @default(now())
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @default(now()) @updatedAt
  source              MarketSource           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  item                Item                   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  deals               Deal[]
  unresolvedMatches   UnresolvedMatchQueue[]

  @@unique([sourceCode, externalListingId])
  @@index([itemId, status, price])
  @@index([status, fetchedAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

model MarketSnapshot {
  id                      String   @id @default(cuid())
  itemId                  String
  scope                   String   @default("ua")
  listingsCount           Int      @default(0)
  lowestPrice             Float?
  lowestPriceWithShipping Float?
  avgPrice                Float?
  medianPrice             Float?
  avgShipping             Float?
  minShipping             Float?
  maxShipping             Float?
  sealedAvgPrice          Float?
  usedAvgPrice            Float?
  confidenceScore         Float    @default(0)
  computedAt              DateTime @default(now())
  item                    Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, computedAt])
}

model DecisionSnapshot {
  id              String    @id @default(cuid())
  itemId          String
  contextType     String
  contextId       String
  action          String
  score           Float
  confidence      Float
  reasonPrimary   String
  reasonSecondary String?
  payloadJson     Json?
  executionStatus String    @default("pending")
  executedAt      DateTime?
  ignoredAt       DateTime?
  createdAt       DateTime  @default(now())
  item            Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([contextType, contextId, createdAt])
  @@index([executionStatus, action, score])
  @@index([itemId, executionStatus])
}

model PurchaseFlowItem {
  id              String        @id @default(cuid())
  watchlistItemId String
  selectedPrice   Float?
  status          String        @default("pending")
  reason          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  watchlistItem   WatchlistItem @relation(fields: [watchlistItemId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model RepriceFlowItem {
  id              String        @id @default(cuid())
  inventoryItemId String
  currentPrice    Float?
  suggestedPrice  Float?
  status          String        @default("pending")
  reason          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model ReviewFlowItem {
  id              String        @id @default(cuid())
  inventoryItemId String
  status          String        @default("pending")
  reason          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Deal {
  id              String        @id @default(cuid())
  listingId       String
  watchlistItemId String
  buyPrice        Float
  targetSellPrice Float
  profit          Float
  roiPercent      Float
  action          String
  score           Float
  status          String        @default("open")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  listing         MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  watchlistItem   WatchlistItem @relation(fields: [watchlistItemId], references: [id], onDelete: Cascade)

  @@unique([watchlistItemId, listingId])
  @@index([status, score])
  @@index([action, status])
}

model Sale {
  id                String        @id @default(cuid())
  inventoryItemId   String
  itemId            String
  quantity          Int           @default(1)
  sellPrice         Float
  costBasis         Float
  profit            Float
  roiPercent        Float
  channel           String?
  buyerName         String?
  notes             String?
  
  isMarketplaceSale Boolean       @default(false)
  commissionAmount  Float?
  sellerPayout      Float?
  payoutStatus      String?       @default("pending") 

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  deletedAt         DateTime?
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  item              Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  orders            Order[]
  returns           ReturnRequest[]
  expenses          Expense[]

  @@index([itemId, createdAt])
  @@index([isMarketplaceSale, payoutStatus])
  @@index([deletedAt])
}

model Order {
  id               String          @id @default(cuid())
  reserveRequestId String?
  inventoryItemId  String?
  saleId           String?
  productTitle     String
  buyerName        String
  contact          String
  status           String          @default("pending")
  sellPrice        Float?
  quantity         Int             @default(1)
  channel          String?
  adminNote        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  deletedAt        DateTime?
  reserveRequest   ReserveRequest? @relation(fields: [reserveRequestId], references: [id], onDelete: SetNull)
  inventoryItem    InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  sale             Sale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  returns          ReturnRequest[]
  expenses         Expense[]

  @@index([status, createdAt])
  @@index([deletedAt])
}

model ReturnRequest {
  id              String        @id @default(cuid())
  saleId          String
  orderId         String?
  inventoryItemId String
  status          String        @default("requested")
  reason          String?
  refundAmount    Float?
  restock         Boolean       @default(true)
  quantity        Int           @default(1)
  adminNote       String?
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  deletedAt       DateTime?
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([deletedAt])
}

model Expense {
  id              String         @id @default(cuid())
  type            String
  category        String
  amount          Float
  currency        String         @default("UAH")
  description     String?
  inventoryItemId String?
  purchaseOrderId String?
  saleId          String?
  orderId         String?
  assignedUserId  String?
  incurredAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  deletedAt       DateTime?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  sale            Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedUser    User?          @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([category, incurredAt])
  @@index([deletedAt])
}

model ReportSnapshot {
  id          String   @id @default(cuid())
  type        String
  periodStart DateTime
  periodEnd   DateTime
  payloadJson Json
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
}

model BackupSnapshot {
  id          String   @id @default(cuid())
  type        String   @default("manual")
  status      String   @default("created")
  payloadJson Json
  notes       String?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
}

model ReserveRequest {
  id              String         @id @default(cuid())
  inventoryItemId String?
  productTitle    String
  name            String
  contact         String
  message         String?
  status          String         @default("pending")
  adminNote       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  orders          Order[]

  @@index([status, createdAt])
}

model Notification {
  id           String   @id @default(cuid())
  title        String
  message      String
  type         String   @default("info")
  read         Boolean  @default(false)
  targetUserId String?
  payloadJson  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  targetUser   User?    @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, read, createdAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  payloadJson Json?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
}

model UnresolvedMatchQueue {
  id              String        @id @default(cuid())
  listingId       String
  sourceCode      String
  titleRaw        String
  normalizedTitle String?
  extractedSetNo  String?
  suggestedItemId String?
  resolvedItemId  String?
  status          String        @default("pending")
  resolutionNote  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  listing         MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model SourceRunLog {
  id            String       @id @default(cuid())
  sourceId      String
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  status        String       @default("running")
  itemsSeen     Int          @default(0)
  itemsMatched  Int          @default(0)
  itemsInserted Int          @default(0)
  itemsUpdated  Int          @default(0)
  errorMessage  String?
  createdAt     DateTime     @default(now())
  source        MarketSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
}

model SyncErrorLog {
  id          String   @id @default(cuid())
  scope       String
  sourceCode  String?
  referenceId String?
  message     String
  detailsJson Json?
  createdAt   DateTime @default(now())

  @@index([scope, createdAt])
}

model ScanJob {
  id           String    @id @default(cuid())
  sourceCode   String
  query        String?
  status       String    @default("queued")
  resultCount  Int       @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
}

model SoldComp {
  id              String   @id @default(cuid())
  sourceCode      String
  externalId      String
  itemId          String?
  title           String
  normalizedTitle String
  extractedSetNo  String?
  soldPrice       Float
  currency        String   @default("UAH")
  soldAt          DateTime
  url             String?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  item            Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([sourceCode, externalId])
  @@index([itemId])
}

model PayoutRequest {
  id        String   @id @default(cuid())
  sellerId  String
  amount    Float
  status    String   @default("pending") 
  cardData  String?  
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, status])
  @@index([status, createdAt])
}

model ScoutLead {
  id          String   @id @default(cuid())
  scoutId     String
  url         String
  notes       String?
  status      String   @default("pending") 
  reward      Float    @default(0)         
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  scout       User     @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  @@index([scoutId, status])
  @@index([status, createdAt])
}